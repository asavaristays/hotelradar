PORT=3000
DATABASE_URL=postgresql:///radar_light
DB_URL=
LOG_LEVEL=info
JWT_SECRET=change-me
AUTH_SECRET=
AUTH_PEPPER=radar-v3-pepper
TOKEN_TTL_MINUTES=720
NODE_ENV=development

CORS_ORIGINS=https://revenue.hotelradar.in,http://localhost:5173
TRUST_PROXY=false
REQUEST_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=240
ENABLE_CONSOLE_LOGS=true
LOG_DIR=logs

REQUIRE_API_KEY=false
INTERNAL_API_KEY=radar-internal-key

SCHEMA_CHECK_STRICT=false
MIGRATION_BASELINE_EXISTING=true

RECALC_QUEUE_POLL_MS=2000
RECALC_QUEUE_MAX_ATTEMPTS=3
RECALC_QUEUE_RETRY_BASE_SECONDS=20
RECALC_QUEUE_RETRY_MAX_SECONDS=300

ALLOW_MOCK_COMPETITOR_FALLBACK=true
ALLOW_ESTIMATED_OTA_PARITY=false
OTA_SNAPSHOT_FILE=
EVENT_SNAPSHOT_FILE=
EVENT_SOURCE_URLS=
EVENT_LINKEDIN_HINTS_FILE=
EVENT_COLLECT_TIMEOUT_MS=15000
ENABLE_WEDDING_SIGNAL_GENERATOR=true
ENABLE_ON_DEMAND_OTA_REFRESH=false
OTA_COLLECT_COMMAND=
ON_DEMAND_OTA_REFRESH_TIMEOUT_MS=45000
ON_DEMAND_OTA_REFRESH_COOLDOWN_SEC=180
GOOGLE_MAPS_API_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
GOOGLE_SEARCH_RESULT_COUNT=5
GOOGLE_SEARCH_LANGUAGE=lang_en
ENABLE_GOOGLE_TRENDS_LIVE=true
GOOGLE_TRENDS_TIMEFRAME=now 7-d
GOOGLE_TRENDS_SNAPSHOT_FILE=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_REPLY_TO=

MARKET_HOTEL_BATCH_SIZE=50
MARKET_HOTEL_COLLECT_TIMEOUT_MS=15000
MARKET_HOTEL_COLLECT_MIN_DELAY_MS=1200
MARKET_HOTEL_GRID_RADIUS_METERS=2500
MARKET_HOTEL_GRID_STEP_METERS=2200
MARKET_HOTEL_NEARBY_RESULT_COUNT=20
MARKET_HOTEL_NEIGHBOR_INSERT_BATCH_SIZE=500
MARKET_HOTEL_NEIGHBOR_PROCESSING_BATCH_SIZE=100
MARKET_HOTEL_NEIGHBOR_MAX_DISTANCE_KM=5
MARKET_HOTEL_NEIGHBOR_MAX_COUNT=20
MARKET_HOTEL_SIGNAL_BATCH_SIZE=500
MARKET_HOTEL_HIGH_REVIEW_RATIO_THRESHOLD=2
MARKET_HOTEL_REPUTATION_WEAK_RATING_THRESHOLD=4
FOCUS_CITIES=Goa,Mumbai,Jaipur
RADAR_FORCE_PRODUCT_UNLOCK=false
