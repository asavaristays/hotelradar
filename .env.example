# HotelRADAR Direct — compose project: hotelradar-direct
# Never commit real secrets. Never share volumes with Asavari or website.hotelradar.

NODE_ENV=development
APP_URL=http://localhost:4100
API_BASE_URL=http://localhost:4101/api/v1

# Bound only on localhost in compose; nginx terminates TLS in production
WEB_PORT=4100
API_PORT=4101

# Direct-owned Postgres (volume: direct_postgres)
POSTGRES_DB=hotelradar_direct
POSTGRES_USER=direct
POSTGRES_PASSWORD=change_me_direct_db
DATABASE_URL=postgresql://direct:change_me_direct_db@postgres:5432/hotelradar_direct

# Direct-owned Redis (volume: direct_redis)
REDIS_URL=redis://redis:6379

AUTH_SECRET=replace-with-long-random-secret
LOG_LEVEL=info

# Super Admin (S1) — bootstrap creates first user only when admin_users is empty
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_SECONDS=43200
ADMIN_BOOTSTRAP_USER=superadmin
ADMIN_BOOTSTRAP_PASSWORD=change_me_admin_10chars
# true only when the browser uses HTTPS (not localhost tunnel)
ADMIN_COOKIE_SECURE=false

# Asavari sync — HTTPS only, no filesystem mounts
ASAVARI_BASE_URL=https://asavaristays.com
ASAVARI_INTEGRATION_AUTH=
ASAVARI_WEBHOOK_SECRET=

# Feature flags — sync pulls HTTPS JSON into asavari_properties cache
# Requires ASAVARI_INTEGRATION_AUTH (Bearer token or "Bearer …" / "raw:…")
ASAVARI_SYNC_ENABLED=true

# OTP — use provider=dev for testing (code returned as dev_code + logged)
OTP_PROVIDER=dev
OTP_TTL_SECONDS=600
OTP_RESEND_COOLDOWN_SECONDS=45
OTP_MAX_ATTEMPTS=5
OTP_REVEAL_DEV_CODE=true

# OpenAI assistant (tools + grounding). Never commit real keys — use .env.deploy / /etc.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Infra — encrypted Postgres dumps (scripts/vps-backup-postgres.sh)
BACKUP_ENCRYPTION_KEY=replace-with-long-random-backup-key
BACKUP_DIR=/var/backups/hotelradar-direct
RETENTION_DAYS=14
