/* ------------------------------------------------------------------ */
/* 1. Settlement mode — manual now, escrow later                       */
/* ------------------------------------------------------------------ */

enum SettlementMode {
  direct_to_hotel // pilot: guest pays hotel, you invoice commission weekly
  escrow          // target: you collect, release on code redemption
}

enum AttestationSource {
  guest_utr
  hotel_confirm
  ops_manual
  webhook
}

