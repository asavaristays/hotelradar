{
  "name": "radar-light",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node src/scripts/runMigrations.js",
    "db:migrate:legacy": "psql \"$DATABASE_URL\" -f db/migrations/001_init.sql && psql \"$DATABASE_URL\" -f db/migrations/002_extend_city_support_jodhpur.sql && psql \"$DATABASE_URL\" -f db/migrations/003_v3_foundation.sql && psql \"$DATABASE_URL\" -f db/migrations/004_super_admin_user_management.sql && psql \"$DATABASE_URL\" -f db/migrations/005_relax_city_constraints.sql && psql \"$DATABASE_URL\" -f db/migrations/006_uttarakhand_operating_cities.sql && psql \"$DATABASE_URL\" -f db/migrations/007_fix_camp_hornbill_city.sql && psql \"$DATABASE_URL\" -f db/migrations/008_fasttrack_calibration_foundation.sql && psql \"$DATABASE_URL\" -f db/migrations/009_calibration_governance.sql && psql \"$DATABASE_URL\" -f db/migrations/010_data_health_tracking.sql && psql \"$DATABASE_URL\" -f db/migrations/011_recalc_queue.sql",
    "db:seed": "psql -v ON_ERROR_STOP=1 \"$DATABASE_URL\" -f db/seeds/seed_pilot.sql",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:contract": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand tests/contracts/dashboardContract.freeze.test.js",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --coverage",
    "calibration:nightly": "node src/scripts/runNightlyCalibration.js",
    "automation:calibrate-latest": "bash scripts/run_latest_data_calibration.sh",
    "calibration:bootstrap-outcomes": "node src/scripts/runOutcomeBootstrap.js",
    "ingestion:events:collect": "node src/scripts/runEventCollector.js",
    "ingestion:ota": "node src/scripts/runOtaIngestion.js",
    "ingestion:public-market-capture": "node src/scripts/runPublicMarketCapture.js",
    "ingestion:realtime-signals": "node src/scripts/runRealtimeSignalCapture.js --once",
    "sources:register": "node src/scripts/registerVerifiedLiveDataSource.js",
    "sources:provision-feed-pack": "node src/scripts/provisionVerifiedSourceFeedPack.js",
    "seed:phase1-market-intelligence": "node src/scripts/seedPhaseOneMarketIntelligence.js",
    "signals:capture": "node src/scripts/captureManualSignal.js",
    "briefs:morning": "node src/scripts/runRevenueIntelligenceMorningBriefs.js",
    "ingestion:events": "node src/scripts/runEventIngestion.js",
    "ingestion:market-hotels": "node src/scripts/runMarketHotelIndex.js",
    "ingestion:market-contact-enrichment": "node src/scripts/runMarketHotelContactEnrichment.js",
    "ingestion:market-neighbors": "node src/scripts/runMarketHotelNeighborIndex.js",
    "ingestion:market-review-signals": "node src/scripts/runMarketHotelReviewSignals.js",
    "ingestion:market-reputation-signals": "node src/scripts/runMarketHotelReputationSignals.js",
    "ingestion:market-chatbot-gap-signals": "node src/scripts/runMarketHotelChatbotGapSignals.js",
    "ingestion:market-ota-dependence-signals": "node src/scripts/runMarketHotelOtaDependenceSignals.js",
    "ingestion:market-demand-surge-clusters": "node src/scripts/runMarketHotelDemandSurgeClusters.js",
    "ingestion:market-price-pressure-signals": "node src/scripts/runMarketHotelPricePressureSignals.js",
    "ingestion:market-event-demand-zones": "node src/scripts/runMarketHotelEventDemandZones.js",
    "ingestion:market-wedding-demand-zones": "node src/scripts/runMarketHotelWeddingDemandZones.js",
    "ingestion:market-corporate-event-clusters": "node src/scripts/runMarketHotelCorporateEventClusters.js",
    "ingestion:market-tourism-spikes": "node src/scripts/runMarketHotelTourismSpikes.js",
    "ingestion:market-airport-demand-signals": "node src/scripts/runMarketHotelAirportDemandSignals.js",
    "ingestion:market-weekend-compression-signals": "node src/scripts/runMarketHotelWeekendCompressionSignals.js",
    "ingestion:market-festival-demand-signals": "node src/scripts/runMarketHotelFestivalDemandSignals.js",
    "ingestion:market-opportunity-feed": "node src/scripts/runMarketOpportunityFeed.js",
    "ingestion:market-ranked-opportunities": "node src/scripts/runMarketRankedOpportunities.js",
    "ingestion:market-benchmarks": "node src/scripts/runMarketHotelBenchmarks.js",
    "intelligence:market:daily": "node src/scripts/runDailyMarketIntelligence.js",
    "intelligence:market:notifications": "node src/scripts/runMarketOpportunityNotifications.js",
    "backfill:hotel-coordinates": "node src/scripts/backfillHotelCoordinates.js",
    "worker:recalc": "node src/scripts/runRecalcWorker.js",
    "worker:realtime-signals": "node src/scripts/runRealtimeSignalCapture.js",
    "deploy:prod": "./deploy.sh",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "nodemailer": "^6.9.15",
    "pdfkit": "^0.19.1",
    "pg": "^8.13.1",
    "winston": "^3.14.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.2.2"
  }
}
